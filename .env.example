# Formato canónico com prefixo DNSUPDATER_ (recomendado: nunca colide com
# vars do sistema como USERNAME). Nomes legados sem prefixo (CPANEL_URL,
# USERNAME, ...) continuam a funcionar no ficheiro; o shim update_ip.sh
# adiciona o prefixo automaticamente quando falta.
DNSUPDATER_CPANEL_URL=https://cpanel.exemplo.com
DNSUPDATER_CPANEL_PORT=2083
DNSUPDATER_USERNAME=o-teu-user
DNSUPDATER_APIKEY=a-tua-api-key
DNSUPDATER_DOMAIN=exemplo.pt
DNSUPDATER_TTL=300
# Lista com fallback (vírgula ou espaço). 15 providers testados por default.
DNSUPDATER_GET_IP_URLS=https://checkip.amazonaws.com, https://ifconfig.me/ip, https://icanhazip.com, https://api.ipify.org, https://v4.ident.me, https://ident.me, https://ifconfig.co/ip, https://ipinfo.io/ip, https://wtfismyip.com/text, https://ipecho.net/plain, https://l2.io/ip, https://myexternalip.com/raw, https://ipv4.icanhazip.com, https://ifconfig.io/ip
#DNSUPDATER_GET_IP_URL=checkip.amazonaws.com
DNSUPDATER_SUBDOMAIN=homeip
# ntfy opcional: ou defines os três ou nenhum (desativa).
DNSUPDATER_NTFY_SERVER=https://ntfy.sh
DNSUPDATER_NTFY_TOPIC=dnsupdate
DNSUPDATER_NTFY_TOKEN=tk_xxx
# Opcionais (defaults entre parêntesis):
#DNSUPDATER_LOG_FILE=/var/log/dnsupdater.log
#DNSUPDATER_STATE_FILE=~/.cache/dnsupdater/state.json
#DNSUPDATER_INTERVAL=5m
#DNSUPDATER_FORCE_REFRESH=1h
#DNSUPDATER_DRY_RUN=false
#DNSUPDATER_VERBOSE=false
