CPANEL_URL=https://cpanel.exemplo.com
CPANEL_PORT=2083
USERNAME=o-teu-user
APIKEY=a-tua-api-key
DOMAIN=exemplo.pt
TTL=300
# Lista com fallback (vírgula ou espaço). Mantém compat com GET_IP_URL único legado.
GET_IP_URLS=https://checkip.amazonaws.com, https://ifconfig.me/ip, https://icanhazip.com, https://api.ipify.org
#GET_IP_URL=checkip.amazonaws.com
SUBDOMAIN=homeip
# ntfy opcional: ou defines os 3 ou nenhum (desativa).
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=dnsupdate
NTFY_TOKEN=tk_xxx
# Opcionais (defaults entre parêntesis):
#LOG_FILE=/var/log/dnsupdater.log
#STATE_FILE=~/.cache/dnsupdater/state.json
#INTERVAL=5m
#FORCE_REFRESH=1h
#DRY_RUN=false
#VERBOSE=false
